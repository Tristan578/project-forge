# ==============================================================================
# Project Forge .gitignore
# ==============================================================================

# ----- Environment & Secrets -----
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
secrets.json

# ----- Claude / AI Tooling -----
# Ignore .claude contents by default, then whitelist essentials
.claude/*
# Track project config, taskboard, skills, hooks, rules, agents
!.claude/CLAUDE.md
!.claude/rules/
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/tools/
!.claude/workflows/
!.claude/settings.json
!.claude/TASKBOARD_SETUP.md
!.claude/SANDBOX.md
!.claude/docs/
# Always ignore local settings, DB, and WAL files
.claude/settings.local.json
.claude/taskboard.db
.claude/taskboard.db-wal
.claude/taskboard.db-shm
# Generated sync state — not for version control
.claude/hooks/github-project-map.json
.claude/hooks/.sync-push.lock
.claude/hooks/.sync-lock-wanted
.claude/hooks/.sync-disabled
.claude/hooks/.sync.log

# ----- Windsurf / AI Tooling -----
# Track Windsurf rules and workflows
!.windsurf/
!.windsurf/rules/
!.windsurf/workflows/
specs/
ARCHITECTURE.md
project_board.json

# ----- Rust / Cargo -----
engine/target/
.transform-gizmo-fork/target/
engine/pkg/
engine/pkg-webgl2/
engine/pkg-webgpu/
engine/pkg-webgl2-runtime/
engine/pkg-webgpu-runtime/

# ----- WASM Build Artifacts (intermediate) -----
# WASM engine binaries are hosted on CDN (Cloudflare R2), not committed to git.
# Set NEXT_PUBLIC_ENGINE_CDN_URL in production to point to the CDN origin.
web/public/engine-pkg-webgl2/
web/public/engine-pkg-webgpu/
web/public/engine-pkg-webgl2-runtime/
web/public/engine-pkg-webgpu-runtime/

# ----- Node / npm -----
# Bare (no trailing slash) on purpose: worktrees symlink web/node_modules at the
# main repo's tree, and a `node_modules/` pattern matches only real directories.
node_modules
web/package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- Next.js -----
web/.next/
web/out/
web/test-results/
web/playwright-report/
web/playwright-report-crossbrowser/
web/blob-report/
# Playwright MCP browser-session scratch output (console-*.log / page-*.yml)
.playwright-mcp/

# ----- Coverage -----
coverage/

# ----- Packages -----
packages/ui/dist/

# ----- TypeScript -----
*.tsbuildinfo

# ----- OS Files -----
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db
nul

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ----- Session artifacts -----
PHASE-*.md
REFACTOR*.md
# ...but not the vendored tdd skill's refactoring.md (case-insensitive FS makes
# REFACTOR*.md swallow it, leaving its SKILL.md link dangling on a fresh checkout).
!.agents/skills/tdd/refactoring.md
*-SUMMARY.md
*-PROGRESS.md
rust_errors.txt
*.backup
do_split.py
extract_handlers.py
split_commands*.py

# ----- AutoForge -----
autoforge/results/*
!autoforge/results/.gitkeep
autoforge/asset-cache/*
!autoforge/asset-cache/.gitkeep
autoforge/node_modules/

# ----- Misc -----
*.log
*.pid
*.seed
*.pid.lock
.cache/
.claude/hooks/__pycache__/

# Taskboard DB files — use OS default path, never commit
.claude/taskboard.db
.claude/taskboard.db-shm
.claude/taskboard.db-wal

# Generated MCP command pages (regenerated on every build)
apps/docs/content/mcp/*.mdx
.vercel
.claude/.env-health-last-check
.worktrees/

# --- Machine artefacts that must never be committed (#9736 follow-up) ---
# A literal `%SystemDrive%` directory appeared at the repo root: a Windows
# environment variable written into a path by a tool running under a POSIX
# shell, which does not expand it. It contained copies of Windows cache
# databases. Ignored so a recurrence cannot be swept in by `git add -A`, and
# named here so the next person to see one knows what it is.
%SystemDrive%/
%USERPROFILE%/
%LOCALAPPDATA%/

# Codex hook runtime state, mirroring the .claude/hooks rules above.
.codex/hooks/__pycache__/
.codex/hooks/.sync-push.lock
.codex/hooks/.sync-lock-wanted
.codex/hooks/.sync.log
*.bak

# --- Half-finished cross-tool port: untracked on purpose (see #9745) ---
# `.codex/agents`, `.codex/hooks`, `.codex/hooks.json` and the project-specific
# skills copied into `.agents/skills/` are a port of the `.claude/` tree that is
# not finished, and committing it would ship instructions that do not work:
#
#   * 143 references to `.Codex/tools`, `.Codex/rules` and `.Codex/skills` —
#     directories that do not exist. Zero TRACKED files contain such a
#     reference; all 19 that do are in this untracked set, so this is damage
#     from a find-and-replace, not an existing convention.
#   * `.codex/hooks.json` wires 26 hooks where `.claude/settings.json` wires 39.
#     Missing are `block-main-commits.sh`, `check-pr-metadata.sh`,
#     `pre-push-quality-gate.sh` and `block-deferred-fixes.sh` — and the Codex
#     profile runs with `approval_policy = "never"`, so those controls would
#     simply be absent rather than merely weaker.
#   * The skills duplicate `.claude/skills/` by hand and have ALREADY drifted
#     (arch-validator and kanban differ from their originals). This repo's
#     answer to that problem is a generator plus a drift gate
#     (`tools/agentic-sync/`, `scripts/check-agentic-sync.sh`), which is how the
#     port should be done rather than by copying.
#
# Ignored rather than left merely untracked so a `git add -A` cannot sweep the
# broken state into the repository while the port is finished.
.codex/agents/
.codex/hooks/
.codex/hooks.json

# The 35 project-specific skills copied from `.claude/skills/`; see the note above.
.agents/skills/api-middleware-migrate/
.agents/skills/arch-validator/
.agents/skills/architect-flow/
.agents/skills/autonomous-sprint/
.agents/skills/babysit-prs/
.agents/skills/build/
.agents/skills/builder/
.agents/skills/capability-review/
.agents/skills/changelog-review/
.agents/skills/claude-platform-reference/
.agents/skills/component-checklist/
.agents/skills/cycle/
.agents/skills/db-migrate/
.agents/skills/deploy-engine/
.agents/skills/design/
.agents/skills/developer-experience/
.agents/skills/dispatch-builder/
.agents/skills/docs/
.agents/skills/env-health-check/
.agents/skills/frontend/
.agents/skills/generate-route/
.agents/skills/infra-services/
.agents/skills/mcp-commands/
.agents/skills/multiplayer-readiness/
.agents/skills/planner/
.agents/skills/pr-code-review/
.agents/skills/pr-green-machine/
.agents/skills/resolve-all-pr-comments/
.agents/skills/resolve-pr-comments/
.agents/skills/review-protocol/
.agents/skills/rust-engine/
.agents/skills/stripe-webhooks/
.agents/skills/testing/
