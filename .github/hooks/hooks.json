{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "[ -n \"${COPILOT_AGENT_PROMPT+x}\" ] || exit 0; bash .claude/hooks/on-session-start.sh",
        "cwd": ".",
        "timeoutSec": 20
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "[ -n \"${COPILOT_AGENT_PROMPT+x}\" ] || exit 0; bash .claude/hooks/on-prompt-submit.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "[ -n \"${COPILOT_AGENT_PROMPT+x}\" ] || exit 0; bash .claude/hooks/on-stop.sh",
        "cwd": ".",
        "timeoutSec": 20
      }
    ]
  }
}
