.github/workflows/*.lock.yml linguist-generated=true

# The Codex CLI surface generated by tools/agentic-sync/port.mjs (#9745) — same
# treatment as the gh-aw locks above: gated by scripts/check-codex-port.sh, so a
# reviewer reads the SOURCE under .claude/ and lets the diff collapse these.
# code-architect.toml is the one hand-written agent and is un-marked again.
# The mirrored skills under .agents/skills/ are NOT listed: that directory also
# holds hand-maintained and third-party skills, a per-skill list here would rot
# with every new skill, and marking the whole directory would hide real edits.
.codex/agents/*.toml              linguist-generated=true
.codex/agents/code-architect.toml -linguist-generated
.codex/hooks.json                 linguist-generated=true
.codex/hook-conditions.json       linguist-generated=true
tools/agentic-sync/port.lock.json linguist-generated=true

# Agentic-sync targets: the generator (tools/agentic-sync/sync.mjs) emits LF, so
# pin the committed form to LF. Without this a CRLF checkout could drift the
# marker block; the generator also normalizes CRLF->LF on read as a belt. `*.md`
# covers AGENTS.md, .github/copilot-instructions.md and .codex/AGENTS.md;
# .cursorrules is the only non-.md target.
*.md            text eol=lf
.cursorrules    text eol=lf

# Shell and Python sources run as-is on every platform the suites target
# (#9611): a CRLF checkout breaks every bash suite at the shebang and every
# hook at its first line. check-source-encoding.sh rejects a stray CR in
# these files as a belt.
*.sh            text eol=lf
*.bash          text eol=lf
*.py            text eol=lf

# Captured performance evidence (#9904): machine-written reports carrying raw
# frame samples, one per line. Review them through the README beside them.
docs/performance/evidence/**/*.json linguist-generated=true
