{
  "name": "@spawnforge/ui",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.15 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "development": "./src/internal.ts",
      "default": "./dist/internal.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "development": "./src/tokens/index.ts",
      "default": "./dist/tokens/index.js"
    },
    "./tokens/theme.css": "./src/tokens/theme.css"
  },
  "scripts": {
    "build": "tsc && cp src/effects/effects.css dist/effects/effects.css && cp src/tokens/theme.css dist/tokens/theme.css",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "clsx": "^2",
    "idb-keyval": "^6.2.2",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "jest-axe": "^10.0.0",
    "jsdom": "^30.0.0",
    "typescript": "^6",
    "vitest": "^4"
  }
}
