{
  "name": "spawnforge",
  "private": true,
  "description": "AI-native 2D/3D game engine for the browser — Bevy/WASM engine, 350 MCP commands, visual scripting, WebGPU rendering",
  "keywords": [
    "game engine",
    "browser game",
    "AI game creation",
    "WebGPU",
    "WebAssembly",
    "WASM",
    "game maker",
    "visual scripting",
    "MCP",
    "model context protocol",
    "2D game engine",
    "3D game engine",
    "no-code game",
    "game development platform",
    "Bevy",
    "Rust game engine"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "web",
    "mcp-server"
  ],
  "engines": {
    "node": ">=24.15 <25"
  },
  "overrides": {
    "@clerk/nextjs": "^7.5.12",
    "@clerk/shared": "^4.25.5",
    "@hono/node-server": "^2.0.5",
    "dompurify": ">=3.4.12",
    "esbuild": ">=0.25.0",
    "fast-xml-parser": ">=5.7.2",
    "hono": "4.12.31",
    "js-cookie": ">=3.0.7",
    "lodash": ">=4.18.1",
    "postcss": ">=8.5.18",
    "next": {
      "postcss": ">=8.5.18",
      "sharp": "^0.35.0"
    },
    "protobufjs": "^7.6.1",
    "qs": ">=6.15.2",
    "uuid": ">=14.0.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "ws": ">=8.20.1",
    "undici": "^8.7.0",
    "vite": "^8.1.3",
    "fast-uri": "^3.1.4"
  },
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "bash scripts/changeset-version.sh",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "storybook": "^10.4.6",
    "turbo": "^2.10.8",
    "vitest": "^4.1.8",
    "sharp": "^0.35.0"
  }
}
