{
  "name": "web",
  "version": "0.4.2",
  "private": true,
  "description": "SpawnForge web frontend — Next.js editor, AI chat, game publishing, and MCP command interface",
  "keywords": [
    "game engine",
    "browser game",
    "AI game creation",
    "WebGPU",
    "WASM",
    "game maker",
    "visual scripting",
    "MCP",
    "2D game engine",
    "3D game engine",
    "no-code game",
    "game development platform"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "portless -- next dev --webpack",
    "dev:raw": "next dev --webpack",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "build:ui": "(cd ../packages/ui && npm run build)",
    "pretest": "npm run build:ui",
    "pretest:changed": "npm run build:ui",
    "pretest:watch": "npm run build:ui",
    "test": "NODE_OPTIONS='--no-experimental-webstorage' vitest run",
    "test:changed": "NODE_OPTIONS='--no-experimental-webstorage' vitest run --changed",
    "test:watch": "NODE_OPTIONS='--no-experimental-webstorage' vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit",
    "check:command-parity": "node scripts/check-command-parity.js",
    "check:bundle-size": "node scripts/check-bundle-size.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/gateway": "^4.0.28",
    "@ai-sdk/mcp": "^2.0.16",
    "@ai-sdk/provider-utils": "^5.0.3",
    "@ai-sdk/react": "^4.0.40",
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@clerk/nextjs": "^7.6.1",
    "@clerk/themes": "^2.4.57",
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.68.0",
    "@spawnforge/ui": "*",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.11.2",
    "acorn": "^8.17.0",
    "ai": "^7.0.11",
    "bcryptjs": "^3.0.3",
    "botid": "^1.5.11",
    "dockview-react": "^7.0.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "jsfxr": "^1.4.1",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "posthog-js": "^1.407.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "svix": "^1.99.1",
    "web-vitals": "^6.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "portless": "^0.15.4",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@types/trusted-types": "^2.0.7"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "dompurify": ">=3.4.12",
    "path-to-regexp": ">=8.4.0",
    "fast-xml-parser": ">=5.7.2",
    "uuid": ">=14.0.0",
    "postcss": ">=8.5.18",
    "next": {
      "postcss": ">=8.5.18"
    },
    "next-intl": {
      "typescript": "$typescript"
    }
  },
  "portless": {
    "name": "spawnforge",
    "tld": "localhost"
  }
}
