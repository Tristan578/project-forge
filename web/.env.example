# =============================================================================
# SpawnForge Environment Variables
# Copy this file to .env.local and fill in your values
#
# Every variable below resolves to at least one real read in `web/` (or is
# explicitly marked as injected by the platform / read by a sibling workspace).
# Uncommented lines are what `cp .env.example .env.local` gives you for local
# dev; commented lines are optional and stay commented so that copy still
# yields a working config.
#
# CAUTION when auditing this file with grep: several of these names are never
# read as a literal `process.env.NAME`. They are read through an indirection
# table — see "Platform API Keys" and "Asset CDN & Storage" below. A name that
# looks unreferenced is not necessarily dead.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL) — REQUIRED
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/forge?sslmode=require

# -----------------------------------------------------------------------------
# Clerk Authentication — REQUIRED
# Get keys at: https://dashboard.clerk.com
#
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is COMMENTED OUT, unlike the two Clerk
# placeholders below it. Per this file's own rule — "commented lines stay
# commented so that copy still yields a working config" — it has to be, because
# it is the one Clerk value the BUILD validates (#9044). Clerk base64-encodes
# its Frontend API host inside the key, so `pk_test_xxx` decodes to an EMPTY
# host and clerk-js loads from `https:///npm/...`; next.config.ts now rejects
# that shape, and a copied template carrying it would fail `npm run dev`
# outright.
#
# Absent is a supported state: the app runs with authentication disabled. To
# enable auth, uncomment and paste your real key from
# https://dashboard.clerk.com — the key ALONE, with no `NAME=` prefix and no
# surrounding whitespace.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_or_pk_test_your_real_key_here
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# -----------------------------------------------------------------------------
# Stripe Payments — REQUIRED for billing
# Get keys at: https://dashboard.stripe.com/apikeys
#
# There is no publishable-key entry here on purpose: checkout is a server-side
# redirect to a Stripe-hosted page, so nothing in web/ loads Stripe.js.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (subscriptions) — REQUIRED for checkout
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_CREATOR=price_xxx
STRIPE_PRICE_STUDIO=price_xxx

# Stripe Price IDs (add-on token packages) — optional
STRIPE_PRICE_TOKEN_SPARK=price_xxx
STRIPE_PRICE_TOKEN_BLAZE=price_xxx
STRIPE_PRICE_TOKEN_INFERNO=price_xxx

# Stripe Tax — optional, default off. Only the exact string "true" enables it;
# when on, checkout sessions are created with automatic_tax.
# STRIPE_TAX_ENABLED=true

# Stripe Radar — optional, default off. Only the exact string "true" enables it;
# when on, payments Radar flags for review are held instead of fulfilled.
# STRIPE_RADAR_REVIEW_HOLD=true

# Stripe Billing Portal configuration ID — optional. Overridable per call; when
# unset and no explicit id is passed, Stripe uses the account default portal.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_xxx

# Stripe billing meters (PF-977/PF-978) — optional, default off. Only the exact
# string "true" enables reporting of confirmed generation token usage to the
# `generation_tokens` meter. The meter must be provisioned first
# (web/scripts/provision-billing-meter.ts), once per Stripe mode.
# See docs/guides/billing-meters-setup.md.
# BILLING_METERS_ENABLED=true

# -----------------------------------------------------------------------------
# Encryption — REQUIRED
# AES-256-GCM key for encrypting BYOK API keys at rest (exactly 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=your-64-char-hex-string

# -----------------------------------------------------------------------------
# Platform API Keys (used for Studio tier users who don't bring their own)
# All optional — features degrade gracefully when missing.
#
# READ VIA INDIRECTION: nothing reads these as `process.env.PLATFORM_X_KEY`.
# The names live in `PLATFORM_KEY_ENV` (web/src/lib/config/providers.ts) and are
# read as `process.env[PLATFORM_KEY_ENV[provider]]`. Grepping for the literal
# name finds only that table. Renaming a value there without renaming it here
# silently degrades the provider — it does not fail at startup. That drift is
# what produced the permanent "AI Assistant: outage" on the status page
# (PF-1054), so the two lists must be kept in sync by hand.
#
# This block is the complete set of PLATFORM_KEY_ENV values, one per provider.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
PLATFORM_MESHY_KEY=xxx
PLATFORM_HYPER3D_KEY=xxx
PLATFORM_ELEVENLABS_KEY=xxx
PLATFORM_SUNO_KEY=xxx   # unobtainable: Suno has no public API; music is declared unavailable in code (#9522) - listed only for PLATFORM_KEY_ENV parity
PLATFORM_OPENAI_KEY=xxx
PLATFORM_REPLICATE_KEY=xxx
PLATFORM_REMOVEBG_KEY=xxx

# Alternative AI providers (fallback routing)
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_PAT=ghp_...
GOOGLE_AI_API_KEY=

# Server-side generation agent — optional, default off. Only the exact string
# "true" routes generation through the agent path.
# USE_GENERATION_AGENT=true

# -----------------------------------------------------------------------------
# autoforge workspace only — NOT read by web/
# `autoforge/autoforge.config.ts` reads these three directly. web/ uses the
# PLATFORM_* names above instead. They are listed here because autoforge has no
# .env.example of its own and inherits the repo-root environment.
# -----------------------------------------------------------------------------
# MESHY_API_KEY=msy_...
# ELEVENLABS_API_KEY=
# SUNO_API_KEY=            # (no such key can be issued - see #9522)

# -----------------------------------------------------------------------------
# Upstash Redis (rate limiting) — optional
# Get keys at: https://console.upstash.com
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
# Maximum database operations per second across instances (default: 80; must be > 0)
DB_RATE_LIMIT_PER_SECOND=80

# -----------------------------------------------------------------------------
# Upstash QStash credentials for durable generation callbacks (PF-906) — optional.
# Leave unset to disable: the durable path is fully dormant and the existing
# client-side poller remains the only completion path. When set, also set
# NEXT_PUBLIC_APP_URL (below) to your PUBLIC origin — QStash delivers the webhook
# from its own infra, so a localhost origin is skipped. See docs/guides/qstash-setup.md.
# Get the token + both signing keys in the Upstash console → QStash tab.
# -----------------------------------------------------------------------------
# QSTASH_TOKEN=xxx
# QSTASH_CURRENT_SIGNING_KEY=sig_xxx
# QSTASH_NEXT_SIGNING_KEY=sig_xxx

# -----------------------------------------------------------------------------
# Error Monitoring (Sentry) — optional, no-ops when missing
# Get DSN at: https://sentry.io
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Source-map upload at build time (@sentry/nextjs). Build-time only — not read
# at runtime. Without it the build still succeeds; stack traces stay minified.
# SENTRY_AUTH_TOKEN=sntrys_xxx
# SENTRY_ORG=tristan-nolan
# SENTRY_PROJECT=spawnforge-ai

# -----------------------------------------------------------------------------
# Analytics (PostHog) — optional
# NEXT_PUBLIC_POSTHOG_KEY alone enables client analytics. Pairing it with
# POSTHOG_PERSONAL_API_KEY additionally activates the local flag evaluator
# (web/src/lib/flags/posthogFlags.ts, PF-971) — the `deep-generation-tier` flag
# and the `provider-kill-switch-<provider>` kill switches. Set only one of the
# two and the evaluator stays dormant with zero network I/O.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# POSTHOG_PERSONAL_API_KEY=phx_xxx

# Capture LLM prompt/completion payloads to PostHog — optional, default off.
# Only the exact string "true" enables it. Leave off unless you have reviewed
# what ends up in the payloads.
# POSTHOG_LLM_CAPTURE=true

# -----------------------------------------------------------------------------
# Application URL — optional, defaults to http://localhost:3000
# Set in production to your actual domain (used for Stripe redirect URLs)
#
# With portless (npm run dev), the local dev URL is:
#   https://spawnforge.localhost
# Git worktrees get branch subdomains automatically, e.g.:
#   https://feat-pf-822.spawnforge.localhost
# Use "npm run dev:raw" to bypass portless and access via localhost:3000.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Canonical public origin used in page metadata and JSON-LD on the marketing
# routes — optional, defaults to https://spawnforge.ai.
# NEXT_PUBLIC_SITE_URL=https://spawnforge.ai

# -----------------------------------------------------------------------------
# Environment — optional, defaults to NODE_ENV
# Set to "staging" on staging deployments for environment-aware behavior
# Vercel auto-fills VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, VERCEL_URL
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENVIRONMENT=staging
# STAGING_URL=https://staging.spawnforge.ai  # Required for CORS on staging deployments

# -----------------------------------------------------------------------------
# Admin Access — optional
# Comma-separated Clerk user IDs that have admin privileges (/admin routes)
# -----------------------------------------------------------------------------
# ADMIN_USER_IDS=user_xxx,user_yyy

# Cron job authentication secret — set in Vercel, must match in cron routes
# CRON_SECRET=your-secret-here

# Comma-separated blocked words for AI content moderation
# MODERATION_BLOCK_LIST=

# Comma-separated trademarked names blocked in generated content — optional.
# Merged with the built-in list; an unset value leaves the built-in list alone.
# TRADEMARK_BLOCK_LIST=

# Log level for server-side structured logging (debug | info | warn | error)
# LOG_LEVEL=info

# Set to "true" in CI when running `next start` without full env (skips validation)
# SKIP_ENV_VALIDATION=

# -----------------------------------------------------------------------------
# Remote MCP server — optional. Both must be set; either one alone leaves the
# HTTP MCP client disabled and the in-process server is used instead.
# -----------------------------------------------------------------------------
# MCP_HTTP_URL=https://mcp.your-domain.com
# MCP_HTTP_TOKEN=xxx

# -----------------------------------------------------------------------------
# Test / build-only flags — not for .env.local in normal development
# -----------------------------------------------------------------------------
# Exposes deterministic test hooks on window for Playwright. Only the exact
# string "true" enables them. NEVER set this in production.
# NEXT_PUBLIC_E2E_HOOKS=true

# MCP editor bridge (#9293). The bridge is opt-in per tab (?mcp=<token>), needs
# the tab's consent prompt approved, and is off in production builds unless this
# is 'true' at build time; the relay defaults to ws://127.0.0.1:3001/api/mcp/ws.
# The relay's own settings (MCP_RELAY_TOKEN — at least 32 chars, MCP_RELAY_PORT,
# MCP_RELAY_EDITOR_ORIGINS) are NOT web env vars: they are read by
# `cd mcp-server && npm run relay`. See mcp-server/README.md and
# docs/guides/mcp-server-setup.md.
# NEXT_PUBLIC_MCP_BRIDGE=true
# NEXT_PUBLIC_MCP_RELAY_URL=ws://127.0.0.1:3001/api/mcp/ws

# Absolute path to an Aseprite binary. Read only by the opt-in Aseprite bridge
# integration test and its fixture recorder — the app never reads it.
# ASEPRITE_PATH=/Applications/Aseprite.app/Contents/MacOS/aseprite

# Set to "1" for `npm run analyze` to emit the bundle visualization. Read by
# next.config.ts at build time only.
# ANALYZE=1

# -----------------------------------------------------------------------------
# AI Deep-Generation Tier — optional, default off
# Routes GDD, world builder, and cutscene generators to Opus 4.8 (AI_MODEL_DEEP)
# when set to exactly "true". Any other value (including "1", "on") keeps the
# primary tier (Sonnet 4.6). See docs/decisions/2026-05-01-opus-deep-tier.md.
# Safe to expose client-side: only toggles which model string is sent to
# /api/chat; all routing decisions happen server-side on every request.
# A PostHog `deep-generation-tier` flag overrides this when the evaluator is
# active — see the PostHog block above.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_USE_DEEP_GENERATION=true

# -----------------------------------------------------------------------------
# WASM Engine CDN — optional, defaults to same-origin (local dev)
# Set to your Cloudflare R2 public URL for production deployments.
# CSP headers auto-allow this origin for script-src and connect-src.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENGINE_CDN_URL=https://engine.spawnforge.ai

# Cache-busting suffix appended to engine asset URLs and the preload hint.
# Set by CI to the engine build SHA; unset means no suffix.
# NEXT_PUBLIC_ENGINE_VERSION=

# -----------------------------------------------------------------------------
# Asset CDN & Storage — optional, defaults to localhost
# Comma-separated list of allowed CDN hosts for asset downloads
# -----------------------------------------------------------------------------
# ASSET_CDN_HOSTS=cdn.your-domain.com

# Public base URL that marketplace asset keys are served from. Distinct from
# NEXT_PUBLIC_ENGINE_CDN_URL (that one is the WASM engine). Signed download URLs
# and the download route's host check both derive from this.
# CDN_URL=https://cdn.your-domain.com

# Object storage for asset uploads (marketplace). Without these, upload returns 501.
#
# READ VIA INDIRECTION, same hazard as the PLATFORM_* block: these four names
# live in `ASSET_STORAGE_ENV` (web/src/lib/config/assetStorage.ts) and are read
# as `process.env[ASSET_STORAGE_ENV.accountId]` etc. There is no
# ASSET_STORAGE_TYPE variable — nothing in the repo has ever read one.
# ASSET_BUCKET_NAME=spawnforge-assets
# ASSET_R2_ACCOUNT_ID=xxx
# ASSET_R2_ACCESS_KEY_ID=xxx
# ASSET_R2_SECRET_ACCESS_KEY=xxx

# -----------------------------------------------------------------------------
# Injected by the platform — do NOT set these manually
#
# Next.js sets NODE_ENV and NEXT_RUNTIME. Vercel sets the rest when
# "Automatically expose system environment variables" is ON. They are listed
# here only so an audit of `process.env` reads against this file comes out
# empty; setting them by hand will make the app disagree with its own runtime.
#
# Skew Protection is enabled via:
#   Vercel Dashboard > Project > Settings > Advanced > Skew Protection
# Next.js 14.1.4+ handles version pinning automatically once enabled.
# Docs: https://vercel.com/docs/skew-protection
# -----------------------------------------------------------------------------
# NODE_ENV                            # development | production | test
# NEXT_RUNTIME                        # "nodejs" or "edge"
# VERCEL                              # "1" when running on Vercel
# VERCEL_ENV                          # production | preview | development
# VERCEL_URL                          # deployment host, no scheme
# VERCEL_GIT_COMMIT_SHA               # full commit SHA of the deployment
# VERCEL_GIT_COMMIT_REF               # branch name of the deployment
# NEXT_PUBLIC_VERCEL_ENV              # client-visible mirror of VERCEL_ENV
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA   # client-visible mirror of the commit SHA
# VERCEL_SKEW_PROTECTION_ENABLED      # "1" when Skew Protection is active
# VERCEL_DEPLOYMENT_ID                # dpl_xxx, unique per deployment
