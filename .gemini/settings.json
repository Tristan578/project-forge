{
  "model": {
    "name": "gemini-3.1-pro-preview"
  },
  "context": {
    "fileName": ["GEMINI.md", "AGENTS.md", ".claude/CLAUDE.md", "CLAUDE.md"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "taskboard-status",
            "type": "command",
            "command": "bash .claude/hooks/on-session-start.sh",
            "timeout": 20000,
            "description": "Load taskboard state and pull GitHub Project changes"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "prompt-check",
            "type": "command",
            "command": "bash .claude/hooks/on-prompt-submit.sh",
            "timeout": 5000,
            "description": "Check for stale tickets and remind about active ticket"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "stop-validation",
            "type": "command",
            "command": "bash .claude/hooks/on-stop.sh",
            "timeout": 20000,
            "description": "Validate ticket docs and push changes to GitHub Project"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "WriteFile|EditFile",
        "hooks": [
          {
            "name": "post-edit-lint",
            "type": "command",
            "command": "bash .claude/hooks/post-edit-lint.sh",
            "timeout": 15000,
            "description": "Run ESLint on changed files"
          }
        ]
      }
    ]
  },
  "general": {
    "defaultApprovalMode": "default"
  },
  "tools": {
    "sandbox": false
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "trust": false
    },
    "neon": {
      "command": "npx",
      "args": ["-y", "@neondatabase/mcp-server-neon"],
      "env": {
        "NEON_API_KEY": "${NEON_API_KEY}"
      },
      "trust": false
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "trust": false
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "trust": false
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server@latest"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "tristan-nolan",
        "SENTRY_PROJECT": "spawnforge-ai"
      },
      "trust": false
    },
    "stripe": {
      "command": "npx",
      "args": ["-y", "@stripe/mcp@latest"],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
      },
      "trust": false
    },
    "upstash": {
      "command": "npx",
      "args": ["-y", "@upstash/mcp-server@latest"],
      "env": {
        "UPSTASH_REDIS_REST_URL": "${UPSTASH_REDIS_REST_URL}",
        "UPSTASH_REDIS_REST_TOKEN": "${UPSTASH_REDIS_REST_TOKEN}"
      },
      "trust": false
    },
    "taskboard": {
      "command": "git",
      "args": ["-c", "alias.spawnforge-taskboard=!node .claude/hooks/taskboard-launch.mjs", "spawnforge-taskboard", "mcp"],
      "trust": false
    }
  }
}
